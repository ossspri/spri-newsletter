# Environment
.env
venv/
.venv/

# Claude Code 메타데이터 (settings·worktrees 등 — 런타임에 자동 갱신되므로 git 추적 안 함)
.claude/

# Credentials
credentials/*
!credentials/.gitkeep
!credentials/google_credentials.sample.json
!credentials/README.md

# Data — 발행 결과물(.md, .csv)은 git으로 동료와 공유.
# 개인용·런타임 파일만 무시 (data/drive_state.json, data/manual_reports/, 레거시 sqlite, FileDB lock).
data/drive_state.json
data/manual_reports/
data/spri_newsletter.db
data/db/.lock
logs/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.pytest_cache/

# IDE
.vscode/
.idea/
*.swp

# Local Task Scheduler backups (contains user SID)
scripts/spri_task_backup.xml

# Extra secret guards (defense-in-depth)
*.env
!.env.example
credentials/google_token.json
credentials/google_credentials.json
credentials/google_credentials*-*.json
